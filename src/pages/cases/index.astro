---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseRow from '../../components/CaseRow.astro';

const cases = (await getCollection('cases')).filter((c) => c.data.status !== 'planned').sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Case guides" current="cases" description="All case-study guides for Paradigms and Perspectives in Psychology.">
  <main id="main" class="page" style="padding-top:2.5rem">
    <h1>Case guides</h1>
    <p class="lede">Each guide covers one study in depth. Start at the guide overview, then follow the pages in order, or jump to the journal section you need.</p>
    <ul class="case-rows">
      {cases.map((c) => <CaseRow c={c} />)}
    </ul>
  </main>
</BaseLayout>

<style>
  .case-rows { list-style: none; padding: 0; margin: 2rem 0; display: grid; gap: 1rem; }
</style>
