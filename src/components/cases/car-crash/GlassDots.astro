---
// Unit chart: one dot per student in Experiment 2 (150 in total, 50 per condition).
// Filled dots said "yes" to "Did you see any broken glass?" a week later. There was no broken glass in the film.
// Source: Loftus and Palmer (1974), Table 2, p. 587.
const conditions = [
  { name: 'Smashed', note: 'asked how fast the cars were going when they "smashed into" each other', color: '#C8752B', yes: 16, n: 50 },
  { name: 'Hit', note: 'asked how fast the cars were going when they "hit" each other', color: '#2F6FB0', yes: 7, n: 50 },
  { name: 'Control', note: 'not asked about speed at all', color: '#1F9E78', yes: 6, n: 50 },
];
---
<figure class="chart glass">
  <p class="chart__title">"Did you see any broken glass?" One week later</p>
  <p class="chart__sub">Each dot is one student. A filled dot is a student who answered "yes". There was no broken glass in the film.</p>
  <ul class="chart__legend">
    <li><span class="swatch" style="background:var(--ink-soft);border-radius:50%" aria-hidden="true" />Said "yes"</li>
    <li><span class="swatch" style="background:#fff;border:2px solid var(--ink-soft);border-radius:50%" aria-hidden="true" />Said "no"</li>
  </ul>
  <div class="glass__grid">
    {conditions.map((c) => (
      <section class="glass__cond">
        <h4><span class="glass__name" style={`color:${c.color}`}>{c.name}</span> <b>{c.yes} of {c.n}</b> said yes ({Math.round((c.yes / c.n) * 100)}%)</h4>
        <p class="glass__note">{c.note}</p>
        <div class="glass__dots" role="img" aria-label={`${c.name}: ${c.yes} of ${c.n} students said they saw broken glass`}>
          {Array.from({ length: c.yes }).map(() => <span style={`background:${c.color};border-color:${c.color}`} />)}
          {Array.from({ length: c.n - c.yes }).map(() => <span class="no" style={`border-color:${c.color}`} />)}
        </div>
      </section>
    ))}
  </div>
  <p class="chart__foot">Source: Loftus and Palmer (1974), Table 2, p. 587. 50 students in each condition.</p>
</figure>

<style>
  .glass__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .glass__cond { border: 1px solid var(--line-soft); border-radius: var(--radius-s); padding: 0.7rem 0.75rem 0.75rem; }
  .glass__cond h4 { margin: 0 0 0.2rem; font-size: 0.95rem; line-height: 1.35; font-weight: 400; }
  .glass__name { display: block; font-weight: 700; font-size: 1.05rem; }
  .glass__cond h4 b { font-variant-numeric: tabular-nums; }
  .glass__note { margin: 0 0 0.6rem; font-size: 0.82rem; line-height: 1.35; color: var(--ink-soft); }
  .glass__dots { display: grid; grid-template-columns: repeat(10, 13px); gap: 5px; }
  .glass__dots span { width: 13px; height: 13px; border-radius: 50%; display: block; border: 2px solid; box-sizing: border-box; }
  .glass__dots span.no { background: #fff; }
  @media (max-width: 760px) { .glass__grid { grid-template-columns: 1fr; } .glass__dots { grid-template-columns: repeat(17, 13px); } }
  @media (max-width: 420px) { .glass__dots { grid-template-columns: repeat(13, 13px); gap: 4px; } }
</style>
